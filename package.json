{
  "name": "opencode-git-commit",
  "version": "3.0.0",
  "description": "Zero-config background git auto-commit plugin for OpenCode CLI",
  "author": "Levent Kurt <reachdevel@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reachdevel/opencode-git-commit.git"
  },
  "homepage": "https://github.com/reachdevel/opencode-git-commit#readme",
